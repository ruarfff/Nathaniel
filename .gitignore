# Godot editor cache and platform build output
.godot/
/exports/*
!/exports/.gdignore
/build/*
!/build/.gdignore
*.ipa
*.dSYM
*.dSYM.zip
xcuserdata/

# Local verification and Python caches
/test-artifacts/*
!/test-artifacts/.gdignore
test-screenshots/
__pycache__/
*.py[cod]
.ruff_cache/

# Local workspaces and operating system files
.workspaces/
.DS_Store

# Blender keeps editable sources; local save backups do not belong in Git.
*.blend[0-9]*
